# ==============================================================================
# DataLens Backend Environment Configuration
# ==============================================================================

# LLM Provider Configuration ('gemini' or 'anthropic')
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Models (spec/plan uses stronger model; extract uses faster model)
# For Gemini, use the current active 3.x series (gemini-2.5 models are deprecated):
SPEC_MODEL=gemini-3.5-flash-lite
EXTRACT_MODEL=gemini-3.5-flash-lite
# For Anthropic:
# SPEC_MODEL=claude-sonnet-4-20250514
# EXTRACT_MODEL=claude-sonnet-4-20250514

# Search Provider Configuration ('ddg' for keyless DuckDuckGo or 'tavily')
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Pipeline & Database Settings
DATABASE_URL=sqlite:///./datalens.db
MAX_PAGES_PER_RUN=8
FETCH_CONCURRENCY=5
PER_DOMAIN_DELAY_SECONDS=2.0
RUN_TIMEOUT_SECONDS=600
CORS_ORIGINS=http://localhost:5173
